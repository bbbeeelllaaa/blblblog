# Database
DATABASE_URL=postgresql+asyncpg://blog_user:blog_password@localhost:5432/blog_db

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Redis
REDIS_URL=redis://localhost:6379/0

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880

# AI (OpenAI compatible API)
AI_API_KEY=sk-your-api-key-here
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
SITE_URL=http://localhost:3000

# SMTP (QQ Mail)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq-email@qq.com
SMTP_PASSWORD=your-qq-auth-code
SMTP_FROM=your-qq-email@qq.com
