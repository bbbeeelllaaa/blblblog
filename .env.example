# ============================================
# blblblog Environment Variables
# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.
# ============================================

# Database (for docker-compose)
DB_USER=blog_user
DB_PASSWORD=blog_password
DB_NAME=blog_db

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Redis
REDIS_URL=redis://redis:6379/0

# AI (OpenAI compatible API, optional — powers semantic search embeddings)
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Site
SITE_URL=http://localhost:3000
NGINX_PORT=8080

# SMTP (QQ Mail — for password reset emails, optional)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
